module Monitor {
  signal cpu = 25.0;
  signal mem = 40.0;
  signal disk = 5.0;
  signal net = 10.0;
  signal cpuAvg = 25.0;
  signal memAvg = 40.0;
  signal cpuThreshold = 40.0;
  signal memThreshold = 85.0;
  signal diskThreshold = 90.0;
  signal lastAlert = "";

  comb cpuHigh = cpuAvg > cpuThreshold;
  comb memHigh = memAvg > memThreshold;
  comb diskHigh = disk > diskThreshold;
  comb anyAlert = cpuHigh || memHigh || diskHigh;
  comb alertCount = edgeCount(cpuHigh) + edgeCount(memHigh) + edgeCount(diskHigh);

  assert anyAlert == (cpuHigh || memHigh || diskHigh);
  assert cpuHigh == (cpuAvg > cpuThreshold);

  always @(posedge cpuHigh) { lastAlert <= "CPU crossed threshold"; }
  always @(negedge cpuHigh) { lastAlert <= "CPU recovered"; }
  always @(posedge memHigh) { lastAlert <= "Memory exceeded threshold"; }
  always @(negedge memHigh) { lastAlert <= "Memory recovered"; }
  always @(posedge diskHigh) { lastAlert <= "Disk exceeded threshold"; }
  always @(negedge diskHigh) { lastAlert <= "Disk recovered"; }

  view {
    <div class="monitor">
      <div class="monitor-metrics">
        <div class="metric">
          <span class="metric-label">CPU</span>
          <span class="metric-value">{round(cpu) + "%"}</span>
          <span class="metric-detail">{"avg " + round(cpuAvg) + "%"}</span>
        </div>
        <div class="metric">
          <span class="metric-label">Memory</span>
          <span class="metric-value">{round(mem) + "%"}</span>
          <span class="metric-detail">{"avg " + round(memAvg) + "%"}</span>
        </div>
        <div class="metric">
          <span class="metric-label">Disk</span>
          <span class="metric-value">{round(disk) + "%"}</span>
        </div>
        <div class="metric">
          <span class="metric-label">Network</span>
          <span class="metric-value">{round(net) + " MB/s"}</span>
        </div>
      </div>
      <p class={anyAlert ? "status-alert" : "status-ok"}>
        {anyAlert
          ? (cpuHigh ? "CPU " : "") + (memHigh ? "MEM " : "") + (diskHigh ? "DISK " : "") + "alert"
          : "All systems normal"}
      </p>
      <p class="alert-info">{"Alerts: " + str(alertCount) + " — " + lastAlert}</p>
      <div class="threshold-controls">
        <label>{"CPU: " + round(cpuThreshold) + "%"} <input type="range" min="0" max="100" @bind=cpuThreshold /></label>
        <label>{"MEM: " + round(memThreshold) + "%"} <input type="range" min="0" max="100" @bind=memThreshold /></label>
        <label>{"DISK: " + round(diskThreshold) + "%"} <input type="range" min="0" max="100" @bind=diskThreshold /></label>
      </div>
    </div>
  }
}

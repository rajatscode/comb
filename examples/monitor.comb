module Monitor {
  signal cpu: float = 25.0;
  signal mem: float = 40.0;
  signal disk: float = 5.0;
  signal net: float = 10.0;
  signal cpuAvg: float = 25.0;
  signal memAvg: float = 40.0;
  signal cpuThreshold: float = 80.0;
  signal memThreshold: float = 85.0;
  signal diskThreshold: float = 90.0;
  signal alertCount: int = 0;
  signal lastAlert: string = "";

  comb cpuHigh = cpuAvg > cpuThreshold;
  comb memHigh = memAvg > memThreshold;
  comb diskHigh = disk > diskThreshold;
  comb anyAlert = cpuHigh || memHigh || diskHigh;
  comb statusText = anyAlert
    ? (cpuHigh ? "CPU " : "") + (memHigh ? "MEM " : "") + (diskHigh ? "DISK " : "") + "alert"
    : "All systems normal";
  comb statusClass = anyAlert ? "status-alert" : "status-ok";

  always @(posedge cpuHigh) {
    alertCount <= alertCount + 1;
    lastAlert <= "CPU crossed threshold";
  }
  always @(negedge cpuHigh) {
    lastAlert <= "CPU recovered";
  }
  always @(posedge memHigh) {
    alertCount <= alertCount + 1;
    lastAlert <= "Memory exceeded threshold";
  }
  always @(negedge memHigh) {
    lastAlert <= "Memory recovered";
  }
  always @(posedge diskHigh) {
    alertCount <= alertCount + 1;
    lastAlert <= "Disk exceeded threshold";
  }
  always @(negedge diskHigh) {
    lastAlert <= "Disk recovered";
  }

  view {
    <div class="monitor">
      <div class="monitor-metrics">
        <div class="metric">
          <span class="metric-label">CPU</span>
          <span class="metric-value">{str(round(cpu)) + "%"}</span>
          <span class="metric-detail">{"avg " + str(round(cpuAvg)) + "%"}</span>
        </div>
        <div class="metric">
          <span class="metric-label">Memory</span>
          <span class="metric-value">{str(round(mem)) + "%"}</span>
          <span class="metric-detail">{"avg " + str(round(memAvg)) + "%"}</span>
        </div>
        <div class="metric">
          <span class="metric-label">Disk</span>
          <span class="metric-value">{str(round(disk)) + "%"}</span>
        </div>
        <div class="metric">
          <span class="metric-label">Network</span>
          <span class="metric-value">{str(round(net)) + " MB/s"}</span>
        </div>
      </div>
      <p class={statusClass}>{statusText}</p>
      <p class="alert-info">{"Alerts: " + str(alertCount) + " — " + lastAlert}</p>
      <div class="threshold-controls">
        <label>{"CPU: " + str(round(cpuThreshold)) + "%"} <input type="range" min="0" max="100" @bind=cpuThreshold /></label>
        <label>{"MEM: " + str(round(memThreshold)) + "%"} <input type="range" min="0" max="100" @bind=memThreshold /></label>
        <label>{"DISK: " + str(round(diskThreshold)) + "%"} <input type="range" min="0" max="100" @bind=diskThreshold /></label>
      </div>
    </div>
  }
}
